{
  "name": "note-taker",
  "productName": "Note Taker",
  "version": "1.0.4",
  "description": "Toma las notas de rodaje mientras la clase se graba en vivo y escribe el XML con el audio para Premiere Pro",
  "main": "main.js",
  "author": "Daniel Gutiérrez",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "atajo": "bash tools/atajo-dev.sh",
    "test": "node tests/run.js",
    "maqueta": "node tools/maqueta/abrir.js",
    "auditar": "node tools/auditar.js",
    "contrastes": "node tools/contrastes.js",
    "build": "bash tools/build-pkg.sh",
    "publish": "bash tools/publish-release.sh"
  },
  "build": {
    "appId": "com.codigo.notetaker",
    "productName": "Note Taker",
    "files": [
      "main.js",
      "preload.js",
      "dev-shot.js",
      "arranque-seguro.js",
      "package.json",
      "version.json",
      "engine/**/*",
      "ipc/**/*",
      "src/**/*",
      "nativo/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "mac": {
      "category": "public.app-category.video",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Note Taker escucha la entrada de audio de la clase para medir el nivel y para reconocer el conteo y la pausa mientras se toman las notas.",
        "NSCameraUsageDescription": "Note Taker muestra en pantalla lo que está entrando por una cámara y saca una foto al cerrarse cada toma. No graba video.",
        "NSAudioCaptureUsageDescription": "Note Taker escucha el sonido de la Mac mientras preparás o grabás una clase: el de Zoom, o todo lo que salga por los altavoces si elegís «Audio del sistema». Lo graba para guardar la clase y reconocer el conteo y la pausa."
      },
      "target": [
        {
          "target": "pkg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "bin/mac",
          "to": "bin",
          "filter": [
            "**/*",
            "!models",
            "!models/**"
          ]
        },
        {
          "from": "plantillas",
          "to": "plantillas",
          "filter": [
            "*.prproj"
          ]
        }
      ]
    },
    "pkg": {
      "artifactName": "NoteTaker-${version}-arm64.${ext}",
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false
    }
  },
  "devDependencies": {
    "electron": "^43.8.7",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.16.0"
  },
  "allowScripts": {
    "electron@43.8.7": true
  }
}
